#!/usr/bin/env python3
# -*- coding: utf-8 -*-
#
# iou_import — build an IOU/IOL NVRAM file from a text startup-config so a fresh
# node boots straight to its prompt with NO "initial configuration dialog".
#
# This is the inverse of the on-box iou_export (dynamips fs_nvram format, by
# Bernhard Ehlers). It emits the uncompressed "raw" layout:
#   - 0xABCD startup section: 36-byte header (magic, format=1, 16-bit checksum,
#     IOS version, start/end address, length) + the config text
#   - 4-byte alignment
#   - 0xFEDC private section: 16-byte header + the private config
#   - zero padding to the NVRAM size
#   - a 16-bit ones-complement (Internet) checksum over the WHOLE NVRAM, stored
#     at offset 4 (verified: IOS computes this over the entire nvram file)
#
# The IOU binary's own "-c <config>" only loads the config into RUNNING-config,
# leaving nvram empty -> IOS shows the setup dialog at boot. Pre-writing nvram
# with this tool puts the config in STARTUP-config, so the dialog never appears.
#
# usage: iou_import [-n SIZE_KB] [-v MAJ.MIN] startup-config nvram-out [private-config]

import sys
import argparse


def inet_cksum(buf):
    """16-bit ones-complement (Internet) checksum over buf (big-endian words)."""
    s = 0
    if len(buf) % 2:
        buf = buf + b"\x00"
    for i in range(0, len(buf), 2):
        s += (buf[i] << 8) | buf[i + 1]
    while s >> 16:
        s = (s & 0xFFFF) + (s >> 16)
    return (~s) & 0xFFFF


def build_nvram(startup, private, size, ios):
    base = size  # IOU maps NVRAM at virtual address == nvram size
    buf = bytearray(36)
    buf[0:2] = (0xABCD).to_bytes(2, "big")
    buf[2:4] = (1).to_bytes(2, "big")        # format 1 = raw / uncompressed
    buf[6:8] = ios.to_bytes(2, "big")        # IOS version (maj<<8|min), informational
    sa = base + 36
    ea = sa + len(startup)
    buf[8:12] = sa.to_bytes(4, "big")
    buf[12:16] = ea.to_bytes(4, "big")
    buf[16:20] = len(startup).to_bytes(4, "big")
    buf += startup
    while len(buf) % 4:                       # 4-byte align the private header
        buf += b"\x00"
    ph = bytearray(16)
    ph[0:2] = (0xFEDC).to_bytes(2, "big")
    ph[2:4] = (1).to_bytes(2, "big")
    ps = base + len(buf) + 16
    pe = ps + len(private)
    ph[4:8] = ps.to_bytes(4, "big")
    ph[8:12] = pe.to_bytes(4, "big")
    ph[12:16] = len(private).to_bytes(4, "big")
    buf += ph + private
    if len(buf) > size:
        raise ValueError("config too large for %d-byte nvram" % size)
    buf += b"\x00" * (size - len(buf))
    buf[4] = 0
    buf[5] = 0
    ck = inet_cksum(buf)
    buf[4:6] = ck.to_bytes(2, "big")
    return bytes(buf)


def main():
    ap = argparse.ArgumentParser(
        description="Build an IOU NVRAM file from a text startup-config."
    )
    ap.add_argument("-n", type=int, default=1024, help="NVRAM size in KB (default 1024)")
    ap.add_argument("-v", default="0.0", help="IOS version MAJ.MIN (default 0.0)")
    ap.add_argument("startup", help="input startup-config text file")
    ap.add_argument("nvram", help="output NVRAM file")
    ap.add_argument("private", nargs="?", help="optional private-config text file")
    a = ap.parse_args()

    with open(a.startup, "rb") as f:
        startup = f.read()
    # IOS keeps a private-config section; a minimal valid one is just "\nend\n".
    if a.private:
        with open(a.private, "rb") as f:
            private = f.read()
    else:
        private = b"\nend\n"

    maj, _, mn = a.v.partition(".")
    try:
        ios = (int(maj) << 8) | int(mn or 0)
    except ValueError:
        ios = 0

    nv = build_nvram(startup, private, a.n * 1024, ios)
    with open(a.nvram, "wb") as f:
        f.write(nv)


if __name__ == "__main__":
    main()
